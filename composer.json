{
  "name": "glook/dadata-php-sdk",
  "description": "Typed PHP SDK for Dadata API generated from OpenAPI schemas.",
  "type": "library",
  "minimum-stability": "stable",
  "license": "MIT",
  "authors": [
    {
      "name": "Andrey Polyakov",
      "email": "andrey@polyakov.im"
    }
  ],
  "require": {
    "php": "^7.4 || ^8.0",
    "ext-json": "*",
    "jane-php/open-api-runtime": "^6.3 || ^7.0",
    "symfony/serializer": "^4.4 || ^5.0",
    "symfony/deprecation-contracts": "^2.5",
    "league/uri": ">=6.5 <6.8",
    "nyholm/psr7": "^1.8",
    "psr/http-client": "^1.0",
    "psr/http-message": "^1.0",
    "psr/http-factory": "^1.0",
    "php-http/discovery": "^1.14",
    "php-http/client-common": "^2.0",
    "php-http/httplug": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Glook\\Dadata\\": "src/",
      "Glook\\Dadata\\Generated\\Suggestions\\": "generated/suggestions/",
      "Glook\\Dadata\\Generated\\Clear\\": "generated/clear/"
    },
    "files": ["src/jane_runtime_compat.php"]
  },
  "autoload-dev": {
    "psr-4": {
      "Glook\\Dadata\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "jane-php/open-api-3": "^6.3.9",
    "php-cs-fixer/shim": "^3.95",
    "phpunit/phpunit": "^9.0",
    "cweagans/composer-patches": "^1.7",
    "doctrine/instantiator": "^1.5",
    "symfony/service-contracts": "^2.5"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "cweagans/composer-patches": true
    }
  },
  "extra": {
    "patches": {
      "jane-php/json-schema": {
        "Fix allOf guesser for JanePHP 6.x": "https://raw.githubusercontent.com/glook/php-vendor-patches/v1.0.0/patches/jane-php/open-api-3/6.x/json-schema/allof-guesser.patch"
      },
      "jane-php/open-api-3": {
        "Fix array item type detection for JanePHP 6.x": "https://raw.githubusercontent.com/glook/php-vendor-patches/v1.0.0/patches/jane-php/open-api-3/6.x/open-api-3/array-item-type.patch"
      }
    }
  },
  "scripts": {
    "generate:clear": [
      "vendor/bin/jane-openapi generate --config-file=config/clear-config.php",
      "composer dump-autoload",
      "@cs"
    ],
    "generate:suggestions": [
      "vendor/bin/jane-openapi generate --config-file=config/suggestions-config.php",
      "composer dump-autoload",
      "@cs"
    ],
    "generate:all": [
      "@generate:clear",
      "@generate:suggestions",
      "@cs"
    ],
    "cs": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
    "test": "phpunit",
    "check": [
      "composer validate --strict --no-check-publish --no-check-lock",
      "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --sequential",
      "@test"
    ]
  }
}
